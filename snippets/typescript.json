{
  "Console Log": {
    "prefix": "log",
    "body": "console.log($0)"
  },
  "Console Warn": {
    "prefix": "warn",
    "body": "console.warn($0)"
  },
  "Console Error": {
    "prefix": "error",
    "body": "console.error($0)"
  },
  "Console Table": {
    "prefix": "table",
    "body": "console.table($0)"
  },
  "Console Time": {
    "prefix": "time",
    "body": [
      "console.time('${1:label}');",
      "$0",
      "console.timeEnd('${1:label}');"
    ]
  },
  "Function": {
    "prefix": "fn",
    "body": [
